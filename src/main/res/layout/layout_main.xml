<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:orientation="vertical"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:gravity="center"
	android:padding="@dimen/layout_padding">

	<TextView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:text="@string/label_instance"
		android:textSize="@dimen/text_size_label" />

	<TextView
		android:id="@+id/current_instance"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginBottom="@dimen/layout_padding"
		android:textSize="@dimen/text_size_instance" />

	<Button
		android:id="@+id/choose_instance"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="@string/choose_instance" />

	<Button
		android:id="@+id/open_app_settings"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="@string/open_app_settings"
		android:visibility="gone" />

</LinearLayout>
